// SkillBridge data model. Mirrored by src/lib/catalog.ts types.
// Security posture:
// - All authorization server-side (see src/lib/authz.ts helpers).
// - Entitlements (enrollment, premium) are written ONLY by server code,
//   payments only after Stripe webhook verification. Never from the client.
// - Every privileged mutation lands in AuditLog.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LEARNER
  REVIEWER
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REFUNDED
}

enum PortfolioStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISIONS_REQUESTED
  APPROVED
  DENIED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  firstName    String?
  lastName     String?
  passwordHash String?
  emailVerifiedAt DateTime?
  tokens       SecurityToken[]
  role         Role         @default(LEARNER)
  premium      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  portfolios   Portfolio[]
  payments     Payment[]
  auditLogs    AuditLog[]
  oauthAccounts OAuthAccount[]
}

// Single-use, hashed tokens for email verification and password reset.
model SecurityToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  purpose   String    // "verify" | "reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// Outgoing email. Sent through the provider when configured; always
// recorded here (the "outbox"), which is also how development and CI
// read verification and reset links without a provider.
model Email {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  sentVia   String   // "resend" | "outbox"
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

// Fixed-window rate limiting that works on serverless: one row per
// (key, window), counted with an atomic upsert.
model RateLimit {
  key     String
  window  Int
  count   Int    @default(1)

  @@id([key, window])
}

// Server errors, captured by instrumentation for the admin page.
model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  digest    String   @default("")
  path      String   @default("")
  stack     String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Reviewer/admin onboarding is by invitation only; nobody self-assigns a role.
model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  role       Role      @default(REVIEWER)
  createdBy  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
}

model OAuthAccount {
  id                String  @id @default(cuid())
  provider          String
  providerAccountId String
  // Whether the provider asserted a verified email when this link was made.
  emailVerified     Boolean @default(false)
  userId            String
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Category {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  scope   String
  courses Course[]
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  code        String       @unique
  title       String
  summary     String
  credits     Int
  level       String
  weeks       Int
  priceUSD    Int
  plaEligible Boolean      @default(true)
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  outcomes    Outcome[]
  modules     Module[]
  enrollments Enrollment[]
  portfolios  Portfolio[]
}

model Outcome {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  position Int
  text     String
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  position Int
  title    String
  summary  String
  lessons  Lesson[]
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  module   Module     @relation(fields: [moduleId], references: [id])
  position Int
  title    String
  minutes  Int
  progress Progress[]
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  progress  Progress[]

  @@unique([userId, courseId])
}

model Progress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

model Portfolio {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  courseId     String
  course       Course            @relation(fields: [courseId], references: [id])
  status       PortfolioStatus   @default(DRAFT)
  narrative    String            @default("")
  // Evaluation result (set only by reviewer/admin actions)
  score        Int?
  decisionNote String            @default("")
  evaluatorId  String?
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  responses    OutcomeResponse[]
  evidence     Evidence[]
}

model OutcomeResponse {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  outcomeId   String
  narrative   String    @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, outcomeId])
}

model Evidence {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  outcomeId   String
  title       String
  kind        String
  note        String    @default("")
  createdAt   DateTime  @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  stripeSessionId String   @unique
  amountUSD       Int
  // Set true only by the Stripe webhook handler after signature verification.
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
