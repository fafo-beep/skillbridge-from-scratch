# Postgres connection string (e.g. from Neon or Vercel Postgres)
DATABASE_URL=
# Random 32+ char secret for Auth.js session signing: `openssl rand -base64 32`
AUTH_SECRET=
# The site's public URL. Used for sitemap/robots AND for every emailed link
# (verification, reset). Required in production outside Vercel; on Vercel
# VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

# Social sign-in (optional). Each provider's button appears automatically
# when its pair of variables is set. Callback URL to register with the
# provider: https://<your-domain>/api/auth/callback/<provider>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Payments (optional until launch). Both required to switch payments on.
# Webhook endpoint to register in Stripe: https://<your-domain>/api/stripe/webhook
# listening for checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded and charge.dispute.created (the last two withdraw premium)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a Stripe Price id for the $99 product; otherwise the price is created inline
STRIPE_PRICE_ID=

# Email (optional until launch). Without it, nothing is sent. Set
# EMAIL_OUTBOX=1 in development and CI only: then messages are recorded in
# the Email table and printed to the server log, links included, so tests
# can read them. Never set it on a real deployment.
RESEND_API_KEY=
EMAIL_OUTBOX=1
# Sender shown to recipients; must be a domain verified in Resend.
EMAIL_FROM="SkillBridge <hello@yourdomain.com>"
