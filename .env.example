# Postgres connection string (e.g. from Neon or Vercel Postgres)
DATABASE_URL=
# Random 32+ char secret for Auth.js session signing: `openssl rand -base64 32`
AUTH_SECRET=
# The site's public URL, used by sitemap/robots
NEXT_PUBLIC_SITE_URL=

# Social sign-in (optional). Each provider's button appears automatically
# when its pair of variables is set. Callback URL to register with the
# provider: https://<your-domain>/api/auth/callback/<provider>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Payments (optional until launch). Both required to switch payments on.
# Webhook endpoint to register in Stripe: https://<your-domain>/api/stripe/webhook
# listening for checkout.session.completed and checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a Stripe Price id for the $99 product; otherwise the price is created inline
STRIPE_PRICE_ID=
